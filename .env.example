# Discord
DISCORD_TOKEN=your-discord-bot-token
DISCORD_REGISTER_GLOBALLY=false
DISCORD_DEV_GUILD_ID=123456789012345678
GUILD_ID=123456789012345678

# MongoDB
MONGODB_URI=mongodb+srv://username:password@dynamo-cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=dynamo-rs

# Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=4000
DASHBOARD_BASE_URL=http://127.0.0.1:4000
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
GOOGLE_TRANSLATE_API_KEY=
# Optional but required to unlock the App Owner Console (/deployment): Base32 RFC 6238 TOTP secret for an authenticator app.
DASHBOARD_OWNER_TOTP_SECRET=
# Optional: defaults to the legacy Dynamo invite permissions bitset.
DISCORD_BOT_INVITE_PERMISSIONS=2146958847

# Command Sync
DISCORD_COMMAND_SYNC_INTERVAL_SECONDS=15

# Logging
RUST_LOG=warn,dynamo_bot=info,dynamo_dashboard=info,dynamo_app=info,dynamo_module_gameinfo=info,poise=info

# Game information cache (relative paths are resolved from the application working directory)
DYNAMO_DATA_DIR=logs
# Optional one-time cache import. The source file is retained; an existing destination wins.
DYNAMO_LEGACY_GAMEINFO_CACHE_PATH=
